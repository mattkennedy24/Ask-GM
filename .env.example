# Local development: copy this file to .env and fill it in
#   cp .env.example .env
#
# On a host such as Railway, set these as service variables instead.
# Never commit a real .env file (it is gitignored).

# Required for chat. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# Access code for the private beta. Leave EMPTY to disable the gate (fine locally).
# When set, visitors must enter it before the grandmasters will answer. The server
# checks it; to rotate it, change the value and redeploy.
BETA_PASSCODE=

# Optional
# PORT=3001
# ANTHROPIC_MODEL=claude-sonnet-4-6
# TRUST_PROXY=1     # reverse proxies in front of the app (the default in production)
